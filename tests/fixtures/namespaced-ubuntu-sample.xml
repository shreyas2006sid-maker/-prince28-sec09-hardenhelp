<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_org.ssgproject.content_benchmark_UBUNTU-22-04">
  <title>Ubuntu 22.04 synthetic importer test</title>
  <Rule id="xccdf_org.ssgproject.content_rule_sshd_disable_root_login" severity="medium">
    <title>SSH root policy</title>
    <description>Prevent direct SSH root login.</description>
    <ident system="https://cce.mitre.org">CCI-000001</ident>
    <check>
      <check-content>sshd -T | grep permitrootlogin</check-content>
    </check>
    <fixtext>Set PermitRootLogin no.</fixtext>
    <fix system="urn:xccdf:fix:script:sh">printf test</fix>
  </Rule>
</Benchmark>
